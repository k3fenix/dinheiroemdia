# ==========================================
# CADÊ MEU DINHEIRO? — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local e preencha com suas credenciais.
# NUNCA insira chaves reais neste arquivo de exemplo.
# ==========================================

# 1. SUPABASE (Configurações Públicas do Cliente)
# Encontradas em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# 2. SUPABASE (Credencial Exclusiva do Servidor - NUNCA expor no frontend)
# Utilizada em rotas de API administrativas, webhooks e verificações privilegiadas.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-privada

# 3. URL PÚBLICA DA APLICAÇÃO
# Em desenvolvimento: http://localhost:3000
# Em produção: https://cademeudinheiro.com.br (ou seu domínio na Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. MERCADO PAGO (Integração de Assinaturas e Pagamentos)
# Obtidas em: Mercado Pago Developers -> Suas Aplicações -> Credenciais
# Apenas usadas no backend (Server Actions / Route Handlers)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-teste-ou-producao
MERCADO_PAGO_WEBHOOK_SECRET=seu-secret-de-assinatura-de-webhook

# 5. CONFIGURAÇÃO DE AMBIENTE
# Valores permitidos: development | production | test
NODE_ENV=development
